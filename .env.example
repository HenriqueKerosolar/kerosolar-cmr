# ── Banco (Supabase — NOVO projeto separado do KeroService) ───────────────────
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[região].pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-0-[região].pooler.supabase.com:5432/postgres"

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ── Sessão (gere com: openssl rand -base64 32) ────────────────────────────────
SESSION_SECRET=""

# ── IA ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# ── Conversions API — Clique-para-WhatsApp (CTWA) ──────────────────────────────
META_DATASET_ID="581688719431430"  # ID do conjunto de dados do Gerenciador de Eventos
META_GRAPH_VERSION="v21.0"          # versão da Graph API usada no envio de eventos
META_CAPI_TOKEN=""                  # token do dataset; se vazio, usa WHATSAPP_CLOUD_TOKEN

# ── Nervo (publica lead.won/lead.lost pro Mind Marketing — receita real) ───────
# Vazio = Nervo desligado (nada muda). Com NERVO_BASE_URL preenchida, o dono precisa aceitar
# o pareamento no painel do Mind (Plataforma → Nervo → Pedidos de conexão) — só uma vez.
NERVO_BASE_URL=""                   # endereço do Mind (https://...)
NERVO_INBOUND_URL=""                # opcional; padrão: NEXT_PUBLIC_APP_URL + /api/public/nervo/inbound
NERVO_ENVIRONMENT="production"      # development | sandbox | staging | production
NERVO_INSTALLATION_ID="kerosolar-crm-prod"
# Workspace do Mind Marketing pra onde publicamos lead.won/lead.lost (achado no painel do Mind;
# nunca hardcode no código-fonte).
MIND_MARKETING_CLIENT_ACCOUNT_ID=""
